# Modelo local de Bastión: Qwen2.5-Coder 7B (recomendado por llmfit para la RTX 4050 de 6 GB)
# con la ventana de contexto ampliada. Por defecto Ollama recorta el contexto y las
# instrucciones de sistema de OpenCode no caben, así que el modelo respondía sin sentido.
FROM qwen2.5-coder:7b
PARAMETER num_ctx 16384
PARAMETER temperature 0.2
